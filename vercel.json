{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && pnpm install && pnpm build && pnpm build:demo",
  "outputDirectory": "frontend/demo/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/playground",
      "destination": "/playground/index.html"
    },
    {
      "source": "/((?!assets/|playground).*.)",
      "destination": "/index.html"
    }
  ]
}
